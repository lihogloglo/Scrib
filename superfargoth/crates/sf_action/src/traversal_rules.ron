// Framework traversal rules (docs/specs/action.md slice B2a). Hosts add them after the base rules
// when their slot source provides the slots' root paths and their shell senses obstacles.
// Numbers are starting points tuned on test courses (anim-lab ledges, `ledges`).
[
    (
        // Waist-high mantle: Jump (or Up) with forward input at a ledge whose top is in the band
        // (character heights: ~0.55-1.5 m for a 1.8 m capsule). The clip's root track is warped
        // onto the top, `inset` m past the lip (a capsule radius plus 0.1 m: standing just over the
        // edge); too large a correction refuses (plain jump). The move ends at `stand`, where the
        // UAL2 `ClimbUp_1m` has both feet on top (right foot planted 0.22-0.50 s, the left lands
        // ~0.6 s; after it the clip steps on), so the clip's walk-on never plays. The clip starts
        // ~0.9 m from the face and travels 1.65 m by then: at the face the warp compresses that
        // to ~0.7 m (ratio up to ~0.57 at the band ends), hence the Linear profile (Late would
        // overshoot the target and pull back).
        id: "traverse.mantle.waist",
        kind: Traversal,
        category: Traversal,
        rank: 200,
        slots: ["traverse.mantle.waist"],
        owner: Warp(target: LedgeTop(inset: 0.4), profile: Linear, refuse_ratio: 0.6, steer: false, stand: Some(0.55)),
        entry: (
            classes: [Jump, Up],
            need_forward: true,
            modes: [Normal, FreeRun],
            states: [Grounded, Coyote],
            speed: Some((0.0, 12.0)),
            probe: Some(Obstacle(classes: [Mantle], height: (0.3, 0.85))),
        ),
        exits: [(on: End, to: Loco)],
        steer: false,
        redo_ticks: 12,
    ),
    (
        // High mantle: the band above the waist one (~1.53-2.25 m for a 1.8 m capsule), same
        // entry. The 2 m climb-up's root rises ~2.4 m and travels 2.0 m over 1.3 s; both feet
        // are on top at ~1.17 s (then the right foot steps on), where the move ends (`stand`):
        // root 2.14 m up and 1.8 m on. Every ledge in the band compresses the rise and the
        // forward travel (ratio <= ~0.45 with the capsule at the face). Ranked below the waist
        // mantle: the shared band edge takes the waist clip. Taller faces (2.5 m, the 3.5 m wall)
        // jump.
        id: "traverse.mantle.high",
        kind: Traversal,
        category: Traversal,
        rank: 190,
        slots: ["traverse.mantle.high"],
        owner: Warp(target: LedgeTop(inset: 0.4), profile: Linear, refuse_ratio: 0.5, steer: false, stand: Some(1.17)),
        entry: (
            classes: [Jump, Up],
            need_forward: true,
            modes: [Normal, FreeRun],
            states: [Grounded, Coyote],
            speed: Some((0.0, 12.0)),
            probe: Some(Obstacle(classes: [Mantle], height: (0.85, 1.25))),
        ),
        exits: [(on: End, to: Loco)],
        steer: false,
        redo_ticks: 12,
    ),
    (
        // Vault over a thin obstacle (the probe's `Vault` class: at most 0.33 h deep, the far
        // floor lower than the top, `vault_room` of clear run-out past the lip; less room mantles).
        // The UAL2 `SafetyVault` (0.73 s; root on the floor, 3.45 m on at run speed, the hips arc
        // to ~1.9 m) plants its right hand at 0.13-0.30 s, 1.29 m up (wrist): an obstacle ~1.26 m
        // high, the top of the band. Warped in two legs (`WarpTarget::Vault`): the hand onto the
        // lip by the plant (each leg's ratio <= `refuse_ratio`, the first leg's slowdown free down
        // to a standstill, never backwards: the hand IK reaches a closer lip; from touching the
        // face to ~1.2 m off), then the landing pulled
        // in to the run-out and onto the far floor. The band's low end keeps the first leg's drop
        // (the whole body, takeoff foot included) under ~0.45 m: 0.45-0.7 h (~0.81-1.26 m for a
        // 1.8 m capsule); lower vault-class obstacles jump. Momentum carries out (no `stand`).
        id: "traverse.vault",
        kind: Traversal,
        category: Traversal,
        rank: 210,
        slots: ["traverse.vault"],
        owner: Warp(target: Vault, profile: Linear, refuse_ratio: 0.9, steer: false, stand: None),
        entry: (
            classes: [Jump, Up],
            need_forward: true,
            modes: [Normal, FreeRun],
            states: [Grounded, Coyote],
            speed: Some((0.0, 12.0)),
            probe: Some(Obstacle(classes: [Vault], height: (0.45, 0.7))),
        ),
        exits: [(on: End, to: Loco)],
        steer: false,
        redo_ticks: 12,
    ),
]
