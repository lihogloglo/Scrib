// Test scenes for visual checks (CLAUDE.md rule 5; docs/visual-checks.md).
// `bevyrrowind scene <name> [more view flags]` opens the interactive viewer here;
// `bevyrrowind scene --list` lists them. Fields:
//   name, cell (view's cell: interior name, exterior name or grid "x,y"),
//   camera ("ex,ey,ez,tx,ty,tz" meters; "+h" = h above ground, exteriors),
//   hour (exteriors; the clock starts paused), flags (more view flags),
//   build (cargo features the exe needs), description, look_for, checks (visual-checks.md ids).
// World meters: x east, z south; a cell is 117.0 m; Balmora is near (-293, 176),
// Seyda Neen (-176, 995), the Red Mountain summit near (293, -878).
#![enable(implicit_some)]
(
    scenes: [
        // ---- far field (far-field.md "Measured on Morrowind", shots/farfield/) ----
        (
            name: "balmora",
            cell: "Balmora",
            hour: 10.0,
            description: "Balmora default camera (150 m SE, 60 m up): far-field baseline, shots/farfield/balmora_a",
            look_for: "town and hills drawn to the horizon; no holes, flicker or seams around the 400 m handoff",
            checks: ["FF-1", "FF-2"],
        ),
        (
            name: "redmtn-view",
            cell: "Balmora",
            camera: "-120,+70,80,293,250,-878",
            hour: 10.0,
            description: "70 m over the hills by Balmora toward Red Mountain (perf scenario red_mountain), shots/farfield/redmtn_view",
            look_for: "the mountain is solid (no see-through gaps; `--off farfield` shows the old gaps)",
            checks: ["FF-3"],
        ),
        (
            name: "summit-vivec",
            cell: "Balmora",
            camera: "293,+30,-878,470,+0,1300",
            hour: 10.0,
