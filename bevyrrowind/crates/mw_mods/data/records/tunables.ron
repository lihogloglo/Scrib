  define(kind: "sf.tunable", id: "shadow.lamp.fade_m", value: (
    value: "35,45",
    source: "guess: covers Balmora street blocks without nearby lamp shadow pop-in (visual-checks/shadows.md, audit 2026-11-01; framework default 15-25 m)",
  )),
]
