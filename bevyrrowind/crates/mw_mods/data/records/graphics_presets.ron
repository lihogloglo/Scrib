// Bevyrrowind's graphics presets (builtin mod `mw`; tunables spec "Presets are bundles of tunables",
// slice T5b): one `sf.tunable_preset` record per driver. `sf.graphics_preset` sets the UE-style
// scalability groups (`sg.*`); each group's levels write its tunables at the `Preset` layer.
// A mod changes a level with its own record naming the same driver (merged in load order, the
// later value wins). Sources: `source` for the record, `sources` per level and key.
// Low..Ultra are the old `Quality` table (golden-tested in mw_exterior_bevy::quality_presets);
// Extremely low is the floor for weak machines and CPU/GPU comparisons, below Low.
[
  define(kind: "sf.tunable_preset", id: "sf.graphics_preset", value: (
    driver: "sf.graphics_preset",
    source: "industry: UE scalability (sg.* groups set together by the overall level)",
    levels: {
      "extremely_low": { "sg.view_distance": "extremely_low", "sg.shadows": "extremely_low", "sg.lighting": "extremely_low", "sg.post": "extremely_low", "sg.textures": "extremely_low", "sg.effects": "extremely_low", "sg.water": "extremely_low", "sg.sky": "extremely_low" },
      "low": { "sg.view_distance": "low", "sg.shadows": "low", "sg.lighting": "low", "sg.post": "low", "sg.textures": "low", "sg.effects": "low", "sg.water": "low", "sg.sky": "low" },
      "medium": { "sg.view_distance": "medium", "sg.shadows": "medium", "sg.lighting": "medium", "sg.post": "medium", "sg.textures": "medium", "sg.effects": "medium", "sg.water": "medium", "sg.sky": "medium" },
      "high": { "sg.view_distance": "high", "sg.shadows": "high", "sg.lighting": "high", "sg.post": "high", "sg.textures": "high", "sg.effects": "high", "sg.water": "high", "sg.sky": "high" },
      "ultra": { "sg.view_distance": "ultra", "sg.shadows": "ultra", "sg.lighting": "ultra", "sg.post": "ultra", "sg.textures": "ultra", "sg.effects": "ultra", "sg.water": "ultra", "sg.sky": "ultra" },
    },
  )),

  // View distance (industry-audit.md J1): one bias scales LOD selection, size culling and the far
  // handoff d1 (the baked 400 m x bias); the size-culling cutoff matches OpenMW's 2 px on High, our
  // 1 px LOD budget on Ultra (ledger statics 2026-10-12).
  define(kind: "sf.tunable_preset", id: "sg.view_distance", value: (
    driver: "sg.view_distance",
    source: "measured: docs/ledger/statics.md 2026-10-12 (bias and size culling per level)",
    levels: {
      "extremely_low": { "lod.bias": 0.5, "lod.size_cull.min_px": 8.0, "lod.size_cull.min_distance_m": 12.0, "far.handoff_scale": 0.5 },
      "low": { "lod.bias": 0.75, "lod.size_cull.min_px": 4.0, "lod.size_cull.min_distance_m": 16.0, "far.handoff_scale": 0.75 },
      "medium": { "lod.bias": 0.875, "lod.size_cull.min_px": 3.0, "lod.size_cull.min_distance_m": 20.0, "far.handoff_scale": 0.875 },
      "high": { "lod.bias": 1.0, "lod.size_cull.min_px": 2.0, "lod.size_cull.min_distance_m": 24.0, "far.handoff_scale": 1.0 },
      "ultra": { "lod.bias": 1.0, "lod.size_cull.min_px": 1.0, "lod.size_cull.min_distance_m": 32.0, "far.handoff_scale": 1.0 },
    },
    sources: {
      "extremely_low": {
        "lod.bias": "industry: UE sg.ViewDistanceQuality 0 (r.ViewDistanceScale 0.4, r.StaticMeshLODDistanceScale up): half of High",
        "lod.size_cull.min_px": "industry: UE r.ViewDistanceScale / cull distance volumes scale screen-size cutoffs; 2x Low's 4 px (guess within it)",
        "lod.size_cull.min_distance_m": "guess: three quarters of Low's 16 m floor",
        "far.handoff_scale": "industry: UE sg.ViewDistanceQuality 0; follows lod.bias as on every other level",
      },
    },
  )),

  // Shadows: the lamp budget High = 8 cached lamps at 512² (perf.md "Shadows v2"); contact shadows
  // off on Low (it costs the depth + motion-vector prepass), 0.3 m = Bevy's default (SH-14), on the
  // lamps on High and Ultra (owner 2026-11-01, SH-16); sun cascades a PSSM practical split (ledger
  // shadows 2026-10-19, presets cut to 160-280 m); PCSS on High and Ultra (shadows F5);
  // Hardware2x2 on Low, else temporal under TAA/DLSS (SH-12).
  define(kind: "sf.tunable_preset", id: "sg.shadows", value: (
    driver: "sg.shadows",
    source: "measured: docs/ledger/shadows.md 2026-10-19 (cascades), owner 2026-11-01 (lamp contact), SH-12/SH-14/SH-16",
    levels: {
      "extremely_low": {
        "shadow.lamp.count": 0, "shadow.lamp.map_size_px": 256, "shadow.lamp.contact": false,
        "shadow.contact": false, "shadow.contact.steps": 8, "shadow.contact.thickness_m": 0.1, "shadow.contact.length_m": 0.3,
        "shadow.sun.cascades": 1, "shadow.sun.distance_m": 120.0, "shadow.sun.split_lambda": 0.82, "shadow.sun.overlap": 0.15,
        "shadow.sun.soft": false, "shadow.sun.soft_size_texels": 10.0, "shadow.filter": "hardware",
      },
      "low": {
        "shadow.lamp.count": 0, "shadow.lamp.map_size_px": 512, "shadow.lamp.contact": false,
        "shadow.contact": false, "shadow.contact.steps": 8, "shadow.contact.thickness_m": 0.1, "shadow.contact.length_m": 0.3,
        "shadow.sun.cascades": 3, "shadow.sun.distance_m": 160.0, "shadow.sun.split_lambda": 0.82, "shadow.sun.overlap": 0.15,
        "shadow.sun.soft": false, "shadow.sun.soft_size_texels": 10.0, "shadow.filter": "hardware",
      },
      "medium": {
        "shadow.lamp.count": 6, "shadow.lamp.map_size_px": 512, "shadow.lamp.contact": false,
        "shadow.contact": true, "shadow.contact.steps": 8, "shadow.contact.thickness_m": 0.1, "shadow.contact.length_m": 0.3,
        "shadow.sun.cascades": 3, "shadow.sun.distance_m": 190.0, "shadow.sun.split_lambda": 0.8, "shadow.sun.overlap": 0.15,
        "shadow.sun.soft": false, "shadow.sun.soft_size_texels": 10.0, "shadow.filter": "auto",
      },
      "high": {
        "shadow.lamp.count": 8, "shadow.lamp.map_size_px": 512, "shadow.lamp.contact": true,
        "shadow.contact": true, "shadow.contact.steps": 16, "shadow.contact.thickness_m": 0.1, "shadow.contact.length_m": 0.3,
        "shadow.sun.cascades": 3, "shadow.sun.distance_m": 205.0, "shadow.sun.split_lambda": 0.8, "shadow.sun.overlap": 0.16,
        "shadow.sun.soft": true, "shadow.sun.soft_size_texels": 10.0, "shadow.filter": "auto",
      },
      "ultra": {
        "shadow.lamp.count": 12, "shadow.lamp.map_size_px": 1024, "shadow.lamp.contact": true,
        "shadow.contact": true, "shadow.contact.steps": 16, "shadow.contact.thickness_m": 0.1, "shadow.contact.length_m": 0.3,
        "shadow.sun.cascades": 4, "shadow.sun.distance_m": 280.0, "shadow.sun.split_lambda": 0.85, "shadow.sun.overlap": 0.2,
        "shadow.sun.soft": true, "shadow.sun.soft_size_texels": 10.0, "shadow.filter": "auto",
      },
    },
    sources: {
      "extremely_low": {
        "shadow.lamp.count": "industry: UE sg.ShadowQuality 0 (no dynamic local-light shadows); Low already 0",
        "shadow.lamp.map_size_px": "industry: UE sg.ShadowQuality 0 (r.Shadow.MaxResolution a quarter of Epic): half of Low's 512",
        "shadow.sun.cascades": "industry: UE sg.ShadowQuality 0 (r.Shadow.CSM.MaxCascades 1)",
        "shadow.sun.distance_m": "industry: UE sg.ShadowQuality 0 (r.Shadow.DistanceScale 0.6): 0.6 x High's 205 m",
        "shadow.filter": "industry: UE sg.ShadowQuality 0 (r.ShadowQuality 1, hardware PCF only); Bevy ShadowFilteringMethod::Hardware2x2",
        "shadow.contact": "industry: UE sg.ShadowQuality 0 (r.ContactShadows 0); Low already off",
        "shadow.sun.soft": "industry: UE sg.ShadowQuality 0 (no PCSS); Low already off",
      },
    },
  )),

  // Lighting: GTAO 1x2 / 2x2 / 3x3 on Medium / High / Ultra (ledger shadows 2026-10-21, ~0.9 ms at
  // 1440p High); the probe GI on High and Ultra (gi.md slice 1).
  define(kind: "sf.tunable_preset", id: "sg.lighting", value: (
    driver: "sg.lighting",
    source: "measured: docs/ledger/shadows.md 2026-10-21 (GTAO per level); gi.md slice 1",
    levels: {
      "extremely_low": { "render.ssao.quality": "off", "render.gi.probes": false },
      "low": { "render.ssao.quality": "off", "render.gi.probes": false },
      "medium": { "render.ssao.quality": "low", "render.gi.probes": false },
      "high": { "render.ssao.quality": "medium", "render.gi.probes": true },
      "ultra": { "render.ssao.quality": "high", "render.gi.probes": true },
    },
    sources: {
      "extremely_low": {
        "render.ssao.quality": "industry: UE sg.PostProcessQuality 0 (r.AmbientOcclusionLevels 0); Low already off",
        "render.gi.probes": "industry: UE sg.GlobalIlluminationQuality 0 (no dynamic GI); Low already off",
      },
    },
  )),

  // Post: bloom off on Low (screen-space-effects research 4.11), its scatter two thirds of
  // Bloom::NATURAL; MSAA on Low, else a temporal resolve (DLSS `auto` in DLSS builds, TAA otherwise;
  // ROADMAP 1.3). Extremely low: DLSS Performance where the build has DLSS, else MSAA.
  define(kind: "sf.tunable_preset", id: "sg.post", value: (
    driver: "sg.post",
    source: "industry: screen-space-effects research 4.11 (bloom); ROADMAP 1.3 (temporal resolve)",
    levels: {
      "extremely_low": { "render.bloom": false, "render.bloom.intensity": 0.1, "render.upscaling": "performance" },
      "low": { "render.bloom": false, "render.bloom.intensity": 0.1, "render.upscaling": "off" },
      "medium": { "render.bloom": true, "render.bloom.intensity": 0.1, "render.upscaling": "auto" },
      "high": { "render.bloom": true, "render.bloom.intensity": 0.1, "render.upscaling": "auto" },
      "ultra": { "render.bloom": true, "render.bloom.intensity": 0.1, "render.upscaling": "auto" },
    },
    sources: {
      "extremely_low": {
        "render.bloom": "industry: UE sg.PostProcessQuality 0 (r.BloomQuality 0); Low already off",
        "render.upscaling": "industry: NVIDIA DLSS programming guide (Performance mode = 50% render scale, the low-end recommendation); UE sg.ResolutionQuality low",
      },
    },
  )),
  // Builds without DLSS: TAA where the others say `auto` (which would resolve to TAA anyway), and MSAA
  // (no temporal resolve) on Extremely low instead of an upscaler the build can't run.
  define(kind: "sf.tunable_preset", id: "sg.post.no_dlss", value: (
    driver: "sg.post",
    when: "!dlss",
    source: "industry: ROADMAP 1.3 (TAA in builds without DLSS)",
    levels: {
      "extremely_low": { "render.upscaling": "off" },
      "medium": { "render.upscaling": "taa" },
      "high": { "render.upscaling": "taa" },
      "ultra": { "render.upscaling": "taa" },
    },
    sources: {
      "extremely_low": { "render.upscaling": "industry: no upscaler in the build: MSAA as Low (UE falls back to its spatial upscaler, which we don't have)" },
    },
  )),

  // Textures: the load cap Low 512, Medium 1024, High 2048, Ultra none (ledger textures 2026-11-13,
  // textures.md §6); parallax none on Low, 16-layer occlusion on Medium, 32/5 and 64/8 relief on
  // High and Ultra (textures.md §9 T4d).
  define(kind: "sf.tunable_preset", id: "sg.textures", value: (
    driver: "sg.textures",
    source: "measured: docs/ledger/textures.md 2026-11-13 (cap); textures.md §9 T4d (parallax)",
    levels: {
      "extremely_low": { "texture.max_size_px": 256, "texture.parallax.layers": 0, "texture.parallax.relief_steps": 0 },
      "low": { "texture.max_size_px": 512, "texture.parallax.layers": 0, "texture.parallax.relief_steps": 0 },
      "medium": { "texture.max_size_px": 1024, "texture.parallax.layers": 16, "texture.parallax.relief_steps": 0 },
      "high": { "texture.max_size_px": 2048, "texture.parallax.layers": 32, "texture.parallax.relief_steps": 5 },
      "ultra": { "texture.max_size_px": 0, "texture.parallax.layers": 64, "texture.parallax.relief_steps": 8 },
    },
    sources: {
      "extremely_low": {
        "texture.max_size_px": "industry: UE sg.TextureQuality 0 (r.Streaming.MipBias up, r.MaxAnisotropy 0): one mip under Low",
        "texture.parallax.layers": "industry: UE sg.ShadingQuality 0 (no parallax occlusion); Low already off",
      },
    },
  )),

  // Effects: no puddles and no shelter map on Low (surface-weather.md "Budget").
  define(kind: "sf.tunable_preset", id: "sg.effects", value: (
    driver: "sg.effects",
    source: "industry: surface-weather.md \"Budget\"",
    levels: {
      "extremely_low": { "surface.puddles": false, "surface.shelter": false },
      "low": { "surface.puddles": false, "surface.shelter": false },
      "medium": { "surface.puddles": true, "surface.shelter": true },
      "high": { "surface.puddles": true, "surface.shelter": true },
      "ultra": { "surface.puddles": true, "surface.shelter": true },
    },
    sources: {
      "extremely_low": { "surface.puddles": "industry: UE sg.EffectsQuality 0; Low already off", "surface.shelter": "industry: UE sg.EffectsQuality 0; Low already off" },
    },
  )),

  // Water: the FFT tier of the level (water.md "Performance budgets"); Low is the lowest tier.
  define(kind: "sf.tunable_preset", id: "sg.water", value: (
    driver: "sg.water",
    source: "industry: water.md \"Performance budgets\"",
    levels: {
      "extremely_low": { "water.quality": "low" },
      "low": { "water.quality": "low" },
      "medium": { "water.quality": "medium" },
      "high": { "water.quality": "high" },
      "ultra": { "water.quality": "ultra" },
    },
    sources: { "extremely_low": { "water.quality": "guess: the lowest tier water.quality offers (as Low)" } },
  )),

  // Sky: the clouds' weather map per sample on High and Ultra (weather.md, distant weather).
  define(kind: "sf.tunable_preset", id: "sg.sky", value: (
    driver: "sg.sky",
    source: "industry: weather.md (distant weather)",
    levels: {
      "extremely_low": { "sky.clouds.map_per_sample": false },
      "low": { "sky.clouds.map_per_sample": false },
      "medium": { "sky.clouds.map_per_sample": false },
      "high": { "sky.clouds.map_per_sample": true },
      "ultra": { "sky.clouds.map_per_sample": true },
    },
    sources: { "extremely_low": { "sky.clouds.map_per_sample": "guess: the lowest cloud sampling there is (as Low)" } },
  )),
]
