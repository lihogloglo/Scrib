// Animation sources (bevyrrowind/docs/specs/animation-sources.md "Import profile").
// Bring your own: the bake reads these files from the user's library folder
// (BEVYRROWIND_ANIM_SOURCES, default `<repo>/animation packs`); nothing here
// is downloaded, and no third-party clip is in the repo or a release.
// A slot's candidates are tried in order (first whose file is present and
// holds the clip), then its fallback. Slot names: superfargoth action.md
// "Move taxonomy" (`kind.family.variant`).
(
  sources: {
    "quaternius_ual1": (
      title: "Quaternius Universal Animation Library (full, 126 clips)",
      license: CC0,
      page: "https://quaternius.itch.io/universal-animation-library",
      files: [
        (name: "AnimationLibrary_Godot.glb", sha256: "f0a1bb22ae29c22a2eb91e2e4641251f9bfbc4470c2153da5666c76c3adf8cef"),
      ],
      // glTF: meters, +Y up, facing +Z (the importer's own space).
      unit_scale: 1.0,
      up: Y,
    ),
    "quaternius_ual2": (
      title: "Quaternius Universal Animation Library 2 (Standard)",
      license: CC0,
      page: "https://quaternius.itch.io/universal-animation-library-2",
      files: [
        (name: "Universal Animation Library 2 [Standard]/Unreal-Godot/UAL2_Standard.glb", sha256: "0815dd05531cae9bc313fc9c0ba81330bc72f8e19ec45f73738e74ddc5796a43"),
      ],
      // Same glTF rig family as UAL1 (meters, +Y up, facing +Z).
      unit_scale: 1.0,
      up: Y,
    ),
    // Ubisoft La Forge Animation Dataset (LAFAN1), 77 BVH mocap takes. Private use only:
    // CC BY-NC-ND 4.0, so cooked clips are never shared. Downloaded as lafan1.zip
    // (SHA-256 ea918082b500a5d158e9d3aa39039df04cd42e25f5c02fe8f7e88e8e9365a977), unzipped
    // into `<library>/lafan1/` (files below under `lafan1/bvh/`).
    "lafan1": (
      title: "Ubisoft La Forge Animation Dataset (LAFAN1)",
      license: CC_BY_NC_ND_4_0,
      page: "https://github.com/ubisoft/ubisoft-laforge-animation-dataset",
      attribution: Some("LAFAN1, Ubisoft La Forge (Harvey et al., Robust Motion In-betweening, SIGGRAPH 2020)"),
      private_only: true,
      files: [
        (name: "bvh/obstacles3_subject4.bvh", sha256: "52084d594a7105fea643dcfb49dcaceee5ff7d25fb9c3a6711e888a174efe263"),
      ],
      // BVH: centimeters, +Y up. No root bone (the hips wander the capture
      // volume): root motion comes from the target pelvis after retargeting.
      unit_scale: 0.01,
      up: Y,
      root_from_pelvis: true,
    ),
  },
  slots: {
    // Waist-high mantle (action.md B2a): one clip, warped onto the ledge by
    // the action clock (`Progress`), so its root track keeps the climb's rise
    // and forward travel. First LAFAN1's walk-in knee mantle onto a 1.02 m
    // obstacle (frames 3715-3815 at 30 Hz), then UAL2's baked `_RM` track.
    "traverse.mantle.waist": (
      graph: "humanoid",
      candidates: [
        (source: "lafan1", file: Some("bvh/obstacles3_subject4.bvh"), clip: "obstacles3_subject4", range: Some((123.83, 127.17))),
        (source: "quaternius_ual2", clip: "ClimbUp_1m_RM"),
      ],
      root: Progress,
      vertical: true,
      fallback: Drop,
    ),
    // Climb up from a hang (B3; unused until then): a top-out that rises
    // ~2.5 m straight up with no forward travel.
    "traverse.climb.up": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "ClimbLedge_RM"),
      ],
      root: Progress,
      vertical: true,
      fallback: Drop,
    ),
  },
)
