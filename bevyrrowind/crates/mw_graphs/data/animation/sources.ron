// Animation sources (bevyrrowind/docs/specs/animation-sources.md "Import profile").
// The bake reads these files from the user's library folder (BEVYRROWIND_ANIM_SOURCES,
// default `<repo>/animation packs`), then the repo's bundled folder
// (`bevyrrowind/assets/animation/quaternius`, Git LFS): the CC0 Quaternius packs ship
// in the repo (owner 2026-10-27); the others are bring-your-own, never downloaded.
// A slot's candidates are tried in order (first whose file is present and
// holds the clip), then its fallback. Slot names: superfargoth action.md
// "Move taxonomy" (`kind.family.variant`).
(
  sources: {
    "quaternius_ual1": (
      title: "Quaternius Universal Animation Library (full, 120 clips, root motion export)",
      license: CC0,
      page: "https://quaternius.itch.io/universal-animation-library",
      attribution: Some("Universal Animation Library by Quaternius (CC0)"),
      // Bundled (bevyrrowind/assets/animation/quaternius/PROVENANCE.md). The `_RM` export:
      // every clip keeps its root-bone travel (the plain UAL1.glb holds the root still).
      files: [
        (name: "UAL1_RM.glb", sha256: "9caacb49bc1bf22457d9152288f2e5c37ff52e6546706bdf7755102108c55a53"),
      ],
      // glTF: meters, +Y up, facing +Z (the importer's own space).
      unit_scale: 1.0,
      up: Y,
    ),
    "quaternius_ual2": (
      title: "Quaternius Universal Animation Library 2 (full, 134 clips, root motion export)",
      license: CC0,
      page: "https://quaternius.itch.io/universal-animation-library-2",
      attribution: Some("Universal Animation Library 2 by Quaternius (CC0)"),
      // Bundled, like UAL1 (the `_RM` export).
      files: [
        (name: "UAL2_RM.glb", sha256: "fecf2e0bf90808b51d12957d179c0cc6587c58d270a7b5b5c29cc2bae0e34332"),
      ],
      // The same rig as UAL1 (meters, +Y up, facing +Z).
      unit_scale: 1.0,
      up: Y,
    ),
    // Ubisoft La Forge Animation Dataset (LAFAN1), 77 BVH mocap takes. Private use only:
    // CC BY-NC-ND 4.0, so cooked clips are never shared. Downloaded as lafan1.zip
    // (SHA-256 ea918082b500a5d158e9d3aa39039df04cd42e25f5c02fe8f7e88e8e9365a977), unzipped
    // into `<library>/lafan1/` (files below under `lafan1/bvh/`).
    "lafan1": (
      title: "Ubisoft La Forge Animation Dataset (LAFAN1)",
      license: CC_BY_NC_ND_4_0,
      page: "https://github.com/ubisoft/ubisoft-laforge-animation-dataset",
      attribution: Some("LAFAN1, Ubisoft La Forge (Harvey et al., Robust Motion In-betweening, SIGGRAPH 2020)"),
      private_only: true,
      files: [
        (name: "bvh/obstacles4_subject3.bvh", sha256: "971cb091da5e74c3ec7b5fdbabb9e56fe50e06f71175a44092b39bb67cbd5e64"),
        (name: "bvh/fallAndGetUp2_subject3.bvh", sha256: "e66fd460eeff103885dbf2ed54482d43761ba1fd8916a41baa6804e5da58725e"),
        (name: "bvh/fallAndGetUp1_subject5.bvh", sha256: "28b6583d317462d6884fccde7e0958fa867bd8386987d91e0a706b3255771fa2"),
        (name: "bvh/fallAndGetUp3_subject1.bvh", sha256: "4a67afdd0ae0aaa1034a59b327fe558a6c8381939a7ac4afca324f4913ba0128"),
        (name: "bvh/fallAndGetUp1_subject4.bvh", sha256: "d0cbd401a8abc5c0e5ac5892ffcc77eff6f19bc2725d4a51c8cb880f423fc53b"),
      ],
      // BVH: centimeters, +Y up. No root bone (the hips wander the capture
      // volume): root motion comes from the target pelvis after retargeting.
      unit_scale: 0.01,
      up: Y,
      root_from_pelvis: true,
      // The zero pose has every bone along +X (no twist reference); every
      // take opens on the actor's T-pose, so frame 0 is the retarget rest.
      rest_frame: Some(0),
    ),
  },
  slots: {
    // Lock-on strafe loops (combat.md CB-2): 8-way walk (UAL2) and jog (UAL1) sets, played by
    // walk and run while `strafing` (mw_graphs build.rs "Lock-on strafe"). Speed-matched like
    // the gaits; the lanes stay in step on their foot-down markers. Cardinals fall back to
    // Morrowind's directional groups, diagonals drop (the space blends the cardinals).
    "loco.walk.fwd": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Fwd_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("WalkForward"),
    ),
    "loco.walk.back": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Bwd_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("WalkBack"),
    ),
    "loco.walk.left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_L_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("WalkLeft"),
    ),
    "loco.walk.right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_R_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("WalkRight"),
    ),
    "loco.walk.fwd_left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Fwd_L_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.walk.fwd_right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Fwd_R_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.walk.back_left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Bwd_L_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.walk.back_right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Walk_Bwd_R_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.jog.fwd": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Fwd_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("RunForward"),
    ),
    "loco.jog.back": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Bwd_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("RunBack"),
    ),
    "loco.jog.left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Left_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("RunLeft"),
    ),
    "loco.jog.right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Right_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Clip("RunRight"),
    ),
    "loco.jog.fwd_left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Fwd_L_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.jog.fwd_right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Fwd_R_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.jog.back_left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Bwd_L_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    "loco.jog.back_right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Jog_Bwd_R_Loop"),
      ],
      looping: Whole,
      root: Match,
      fallback: Drop,
    ),
    // Waist-high mantle (action.md B2a): one clip, warped onto the ledge by
    // the action clock (`Progress`), so its root track keeps the climb's rise
    // and forward travel. First UAL2's root-motion take, then LAFAN1's
    // run-in step-up onto a 1.05 m box (frames 5982-6036 at 30 Hz). No LAFAN1
    // waist mantle is a clean forward one: every walk-in knee mantle turns the
    // pelvis 45-130 degrees, and the one straight take (obstacles5_subject3
    // 6986-7046) ends crouched, so its pelvis root rises only half the box.
    "traverse.mantle.waist": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "ClimbUp_1m"),
        (source: "lafan1", file: Some("bvh/obstacles4_subject3.bvh"), clip: "obstacles4_subject3", range: Some((199.40, 201.20))),
      ],
      root: Progress,
      vertical: true,
      fallback: Drop,
    ),
    // High mantle (action.md B2): the band above the waist mantle (~1.6-2.2 m
    // ledges), UAL2's 2 m root-motion climb-up, warped onto the ledge like the
    // waist one. No fallback clip: without it the move refuses into a jump.
    "traverse.mantle.high": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "ClimbUp_2m"),
      ],
      root: Progress,
      vertical: true,
      fallback: Drop,
    ),
    // Climb up from a hang (B3; unused until then): a top-out that rises
    // ~2.5 m straight up with no forward travel.
    "traverse.climb.up": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "ClimbLedge"),
      ],
      root: Progress,
      vertical: true,
      fallback: Drop,
    ),
    // Get-ups for Delirium's fallen hand-back (mw_delirium_bevy), one per way the body
    // lies: in place, re-based on the last frame (ends standing over the frame).
    // Quaternius first (CC0, the baseline packs), then LAFAN1 takes, lying still to
    // standing still (frames at 30 Hz; DE-1), cut where the
    // feet are planted once up (no steps after standing: the idle carries on in place).
    // Morrowind's `Knockout@tail` (on the left side) is always a candidate, the
    // baseline, and the only one without them. No left-side slot: the one LAFAN1 take
    // (fallAndGetUp3_subject1 2472-2572) walks 1 m once up with no still stance to cut at.
    // Face up: UAL2 LayToIdle; LAFAN1 propped on the elbows, rolls to the left side, kneels, stands (2062-2152).
    "getup.supine": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "LayToIdle"),
        (source: "lafan1", file: Some("bvh/fallAndGetUp2_subject3.bvh"), clip: "fallAndGetUp2_subject3", range: Some((68.73, 71.73))),
      ],
      in_place: true,
      fallback: Drop,
    ),
    // Face down: UAL1 Crawl_Exit (on all fours to standing); LAFAN1 on the elbows, pushes up to a kneel, stands (2508-2614).
    "getup.prone": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Crawl_Exit"),
        (source: "lafan1", file: Some("bvh/fallAndGetUp1_subject5.bvh"), clip: "fallAndGetUp1_subject5", range: Some((83.60, 87.13))),
      ],
      in_place: true,
      fallback: Drop,
    ),
    // On the right side: sits up, turns onto the knees, stands, feet planted (3674-3787;
    // the take's two settle steps after, 0.6 m, are cut).
    "getup.side_right": (
      graph: "humanoid",
      candidates: [
        (source: "lafan1", file: Some("bvh/fallAndGetUp1_subject4.bvh"), clip: "fallAndGetUp1_subject4", range: Some((122.47, 126.23))),
      ],
      in_place: true,
      fallback: Drop,
    ),
    // Combat C1b (combat-adapter.md "C1b: game items"; names = mw_combat::sheet_slots(SWORD_1H)).
    // Clip moves on the action clock (`Progress`); the sheet's windows are authored against
    // each slot's first candidate. Light chain: UAL2's four-hit light sword combo (Sword_Light_A-D,
    // the takes of Sword_Light_Combo), then UAL1's single swing (its root-motion take steps 1.5 m;
    // only without UAL2), then Morrowind's one-hand slash.
    "attack.sword_1h.light1": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_A"),
        (source: "quaternius_ual1", clip: "Sword_Attack"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@slash"),
    ),
    "attack.sword_1h.light2": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_B"),
        (source: "quaternius_ual1", clip: "Sword_Attack"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@slash"),
    ),
    "attack.sword_1h.light3": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_C"),
        (source: "quaternius_ual1", clip: "Sword_Attack"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@slash"),
    ),
    // The finisher: its take ends in its own recovery (no `_rec` slot).
    "attack.sword_1h.light4": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_D"),
        (source: "quaternius_ual1", clip: "Sword_Attack"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@slash"),
    ),
    // Recoveries when the chain stops (no Morrowind equivalent).
    "attack.sword_1h.light1_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_A_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "attack.sword_1h.light2_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Light_B_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "attack.sword_1h.light3_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "SwordLight_C_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    // Heavy chain: UAL2's four-hit heavy sword combo (Sword_Heavy_A-D, the takes of
    // Sword_Heavy_Combo), then Morrowind's one-hand chop.
    "attack.sword_1h.heavy1": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_A"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@chop"),
    ),
    "attack.sword_1h.heavy2": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_B"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@chop"),
    ),
    "attack.sword_1h.heavy3": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_C"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@chop"),
    ),
    // The finisher: its take ends in its own recovery (no `_rec` slot).
    "attack.sword_1h.heavy4": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_D"),
      ],
      root: Progress,
      fallback: Clip("WeaponOneHand@chop"),
    ),
    "attack.sword_1h.heavy1_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_A_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "attack.sword_1h.heavy2_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_B_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "attack.sword_1h.heavy3_rec": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Sword_Heavy_C_Rec"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    // Rolls: Morrowind has none, so no fallback (a roll without a clip refuses the move).
    "dodge.roll.fwd": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Roll"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "dodge.roll.left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Dodge_Left"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    "dodge.roll.right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Dodge_Right"),
      ],
      root: Progress,
      fallback: Drop,
    ),
    // Hit reactions (forced Clip moves by tier and side), Morrowind's Hit1-5 behind.
    "react.small.front": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Hit_Chest"),
      ],
      root: Progress,
      fallback: Clip("Hit1"),
    ),
    "react.small.left": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Hit_Shoulder_L"),
      ],
      root: Progress,
      fallback: Clip("Hit2"),
    ),
    "react.small.right": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Hit_Shoulder_R"),
      ],
      root: Progress,
      fallback: Clip("Hit3"),
    ),
    "react.small.back": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual1", clip: "Hit_Stomach"),
      ],
      root: Progress,
      fallback: Clip("Hit4"),
    ),
    // Medium and Large share the knockback (spec: root x0.25 / x0.6 once the manifest
    // carries a root scale; full travel until then).
    "react.medium.front": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Hit_Knockback"),
      ],
      root: Progress,
      fallback: Clip("Hit5"),
    ),
    "react.large.front": (
      graph: "humanoid",
      candidates: [
        (source: "quaternius_ual2", clip: "Hit_Knockback"),
      ],
      root: Progress,
      fallback: Clip("Hit5"),
    ),
  },
)
