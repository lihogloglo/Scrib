        (name: "sit1/seat.stool.enter.left.seat64/seat.stool.enter.left.seat64.02.bvh", sha256: "8bb8cae671e0730f5c666d5f609ae6ae78e5640f26e7becc1b06c2b1c834e1d2"),
        (name: "sit1/seat.stool.exit.front.seat64/seat.stool.exit.front.seat64.01.bvh", sha256: "17e2831070485c5ed1b3174a34a4183fc4bb2c309e4a3833f2d46e762785e48a"),
        (name: "sit1/seat.stool.exit.left.seat64/seat.stool.exit.left.seat64.02.bvh", sha256: "81ea06e56c6649eceffe71ce59b8f45c12dae66d83d8ba6fdbb28c4777c2fc5f"),
        (name: "sit1/seat.stool.loop.fidget.seat64/seat.stool.loop.fidget.seat64.01.bvh", sha256: "10b2a6771dce49c53070b6093d4809d8e63bdf9638c51e0ab4e8abe00d8d6e31"),
        (name: "sit1/seat.stool.loop.rest.seat64/seat.stool.loop.rest.seat64.00.bvh", sha256: "7edde7fb67c5cc10a4bcdc9d002ce4355fe24946f1669a5b88282c3e4175c6e3"),
      ],
      // Kimodo's BVH: centimeters, +Y up, facing +Z, written with
      // `--bvh_standard_tpose` (the zero pose is a T-pose: auto-align's
      // reference; the default BONES-SEED rest has every bone along +X).
      // `Root` is a static wrapper: root motion from the target pelvis.
      unit_scale: 0.01,
      up: Y,
      root_from_pelvis: true,
      // Retarget pose (UE5 "Edit Retarget Pose"): Kimodo walks hold the clavicles
      // 10.5 deg below its level T-pose (mean over the 24 loco1 walk.cycle takes, both
      // sides, `generated_arms.rs` measure_generated_clavicle_offset; runs +1..+3), so the
      // shoulder's deltas start from there and Morrowind's clavicle stays near its bind in
      // walks. An offset turns the bone's subtree: the upper arm's counter-offset keeps the
      // arm's reference at the T-pose (its direction already matches).
      pose_offsets: [
        (limb: Shoulder, raise_deg: -10.5),
        (limb: UpperArm, raise_deg: 10.5),
      ],
    ),
  },
  slots: {
    // The modern gait set (animation-sources.md "Gait set", ROADMAP 3.4c A3): free
    // movement's synced 1D blend over speed, walk / jog / sprint at the gait speeds
    // 1.6 / 4.5 / 7.0 m/s (`mw_graphs::build::gaits`). Kimodo loco1 takes, cut into
    // seamless loops at the cook (`loop_cut`, defaults: 1-2 strides between same-foot
    // touchdowns); capsule-driven (`Match`: the take's heading drift per loop is not
    // applied). Measured cut loops (`mw_bake/tests/loop_cut.rs`): walk take 05 1.47 m/s,
    // seam foot residue 0.18 cm/frame; jog run.cycle.3 take 04 4.88 m/s, 0.79; sprint
    // sprint.cycle.1 take 05 7.19 m/s, 2.03 (owner "maybe": a retimed free sprint is
    // the next A/B). No library: the slots drop and free movement keeps the Morrowind
    // sets. Styles (3.4d) are `loco.<style>.<gait>.cycle`, falling back to these.
    "loco.walk.cycle": (
      graph: "humanoid",
      candidates: [
        (source: "generated", file: Some("loco1/loco.walk.cycle.1/act/loco.walk.cycle.1.act.ground0.05.bvh"), clip: "loco.walk.cycle.1.act.ground0.05"),
      ],
      root: Match,
      loop_cut: Some(()),
      fallback: Drop,
    ),
    "loco.jog.cycle": (
      graph: "humanoid",
      candidates: [
        (source: "generated", file: Some("loco1/loco.run.cycle.3/act/loco.run.cycle.3.act.ground0.04.bvh"), clip: "loco.run.cycle.3.act.ground0.04"),
      ],
      root: Match,
      loop_cut: Some(()),
      fallback: Drop,
    ),
    "loco.sprint.cycle": (
      graph: "humanoid",
      candidates: [
        (source: "generated", file: Some("loco1/loco.sprint.cycle.1/act/loco.sprint.cycle.1.act.ground0.05.bvh"), clip: "loco.sprint.cycle.1.act.ground0.05"),
      ],
      root: Match,
      loop_cut: Some(()),
      fallback: Drop,
    ),
    // Seat slots (motion-generation.md "AN26b design"; interaction.md "Using a slot"):
    // `<family>[.<style>].b<band cm>.{enter.<side>, loop, loop.fidget, exit.<side>}`, sit1 picks
    // (lowest foot-slide p95 of the non-gated takes; provisional until the owner's ANIM-9). The
    // shell binds `interact.sit.*` to the nearest-band set of the seat's `SeatClips` family.
    // `pelvis_fit` lifts the seated hub's pelvis to band + 0.05 m (the `sit.chair` hub offset):
    // Kimodo keeps the hips at 0.53-0.57 m whatever seat height is asked. `.right` = the
    // `.left` take mirrored at the cook. Loops are exact on their hub (hub_loop jobs): `Whole`.
    "seat.bench.b48.enter.front": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.enter.front.seat48/seat.bench.enter.front.seat48.01.bvh"), clip: "seat.bench.enter.front.seat48.01")], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.bench.b48.enter.left": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.enter.left.seat48/seat.bench.enter.left.seat48.00.bvh"), clip: "seat.bench.enter.left.seat48.00")], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.bench.b48.enter.right": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.enter.left.seat48/seat.bench.enter.left.seat48.00.bvh"), clip: "seat.bench.enter.left.seat48.00", mirror: Some(()))], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.bench.b48.exit.front": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.exit.front.seat48/seat.bench.exit.front.seat48.00.bvh"), clip: "seat.bench.exit.front.seat48.00")], pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
    "seat.bench.b48.exit.left": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.exit.left.seat48/seat.bench.exit.left.seat48.01.bvh"), clip: "seat.bench.exit.left.seat48.01")], pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
    "seat.bench.b48.exit.right": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.exit.left.seat48/seat.bench.exit.left.seat48.01.bvh"), clip: "seat.bench.exit.left.seat48.01", mirror: Some(()))], pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
    "seat.bench.b48.loop.fidget": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.loop.fidget.seat48/seat.bench.loop.fidget.seat48.03.bvh"), clip: "seat.bench.loop.fidget.seat48.03")], looping: Whole, pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
    "seat.bench.b48.loop": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.bench.loop.rest.seat48/seat.bench.loop.rest.seat48.01.bvh"), clip: "seat.bench.loop.rest.seat48.01")], looping: Whole, pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
    "seat.chair.b48.enter.front": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.front.seat48/seat.chair.enter.front.seat48.00.bvh"), clip: "seat.chair.enter.front.seat48.00")], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.chair.b54.enter.front": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.front.seat54/seat.chair.enter.front.seat54.01.bvh"), clip: "seat.chair.enter.front.seat54.01")], pelvis_fit: Some((target_m: 0.59, hub: Last)), fallback: Drop),
    "seat.chair.b48.enter.left": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.left.seat48/seat.chair.enter.left.seat48.00.bvh"), clip: "seat.chair.enter.left.seat48.00")], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.chair.b48.enter.right": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.left.seat48/seat.chair.enter.left.seat48.00.bvh"), clip: "seat.chair.enter.left.seat48.00", mirror: Some(()))], pelvis_fit: Some((target_m: 0.53, hub: Last)), fallback: Drop),
    "seat.chair.b54.enter.left": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.left.seat54/seat.chair.enter.left.seat54.02.bvh"), clip: "seat.chair.enter.left.seat54.02")], pelvis_fit: Some((target_m: 0.59, hub: Last)), fallback: Drop),
    "seat.chair.b54.enter.right": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.enter.left.seat54/seat.chair.enter.left.seat54.02.bvh"), clip: "seat.chair.enter.left.seat54.02", mirror: Some(()))], pelvis_fit: Some((target_m: 0.59, hub: Last)), fallback: Drop),
    "seat.chair.b48.exit.front": (graph: "humanoid", candidates: [(source: "generated", file: Some("sit1/seat.chair.exit.front.seat48/seat.chair.exit.front.seat48.01.bvh"), clip: "seat.chair.exit.front.seat48.01")], pelvis_fit: Some((target_m: 0.53, hub: First)), fallback: Drop),
