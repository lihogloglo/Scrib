        (name: "sit1/seat.floor.loop.fidget.seat14/seat.floor.loop.fidget.seat14.02.bvh", sha256: "41a460086a81284d1cb34905b111a4c5d2922d6932bfa1a1cbb708676e812b43"),
        (name: "sit1/seat.floor.loop.rest.seat14/seat.floor.loop.rest.seat14.00.bvh", sha256: "64b18bd3726e805cc31eaeaa0432cf85ea14bc6ebf0794b534f728354017af74"),
