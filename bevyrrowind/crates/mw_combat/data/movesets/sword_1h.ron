// The one-handed sword sheet (combat.md "C1b" first sheet values; combat-adapter.md "C1b: game
// items"). Times are move seconds (after `rate`), authored against each slot's first candidate
// clip (UAL2 Sword_Regular_A/B/C, UAL1 Roll_RM / Dodge_*_RM). Tune at CB-1
// (docs/visual-checks/combat.md). Weapon segment: in the "Weapon Bone" socket's space, m.
// Light `root_scale`: each swing steps ~0.4 m (Elden Ring 0.3-0.5). Retargeted UAL2 root travel,
// m: A 0.98 + A_Rec 0.37, B 0.06 + B_Rec 0.44, C 1.85 (mw_combat test `light_attacks_step_...`).
(
    id: "sword_1h",
    rig: "humanoid",
    defaults: (turn: 360.0, hit_stop: (hold: 0.06, ease: 0.10), blend_in: 0.10),
    weapon: (socket: "weapon", segment: ((0.0, 0.08, 0.0), (0.0, 0.95, 0.0)), radius: 0.08),
    moves: {
