// The one-handed sword sheet (combat.md "C1b" first sheet values; combat-adapter.md "C1b: game
// items"). Times are move seconds (after `rate`), authored against each slot's first candidate
// clip (UAL2 Sword_Light_A/B/C/D + their _Rec, UAL1 Roll_RM / Dodge_*_RM). Tune at CB-1
// (docs/visual-checks/combat.md). Weapon segment: in the "Weapon Bone" socket's space, m.
// Light chain = UAL2's four-hit light combo. Hit windows sit on the right hand's speed peak
// (A 0.20, B 0.25, C 0.45, D 0.30 s, +-0.07); light1/light2 Cancel(Light) at the strike clip's end,
// where its pose is the next strike's first frame. Light `root_scale`: each swing steps ~0.4 m
// (Elden Ring 0.3-0.5). Retargeted UAL2 root travel, m: A 0.37 + A_Rec 0, B 0.43 + B_Rec 0,
// C 1.69 + C_Rec 0, D 2.03 (mw_combat test `light_attacks_step_less_than_a_stride`).
(
    id: "sword_1h",
    rig: "humanoid",
    defaults: (turn: 360.0, hit_stop: (hold: 0.06, ease: 0.10), blend_in: 0.10),
    weapon: (socket: "weapon", segment: ((0.0, 0.08, 0.0), (0.0, 0.95, 0.0)), radius: 0.08),
    moves: {
        "light1": (
            category: Attack, classes: [Light], from: [Any], rank: 10,
            slots: ["attack.sword_1h.light1", "attack.sword_1h.light1_rec"], root_scale: 1.0,
            windows: [
                Accept([Light, Heavy, Dodge], 0.10, End),
                Cancel([Dodge], 0.31, End), Cancel([Light, Heavy], 0.37, End), Cancel([Move], 0.57, End),
                Turn(360.0, 0.0, 0.11), NoTurn(0.11, 0.28),
            ],
            hits: [(window: (0.14, 0.28), mv: 1.0, stamina: 12.0, kind: "slash", tier: Small, stop: 0.05)],
            next: { Light: "light2" },
        ),
        "light2": (
            category: Attack, classes: [Light],
            slots: ["attack.sword_1h.light2", "attack.sword_1h.light2_rec"], root_scale: 1.0,
            windows: [
                Accept([Light, Heavy, Dodge], 0.10, End),
                Cancel([Dodge], 0.36, End), Cancel([Light, Heavy], 0.43, End), Cancel([Move], 0.66, End),
                Turn(360.0, 0.0, 0.15), NoTurn(0.15, 0.32),
            ],
            hits: [(window: (0.18, 0.32), mv: 1.0, stamina: 12.0, kind: "slash", tier: Small, stop: 0.05)],
            next: { Light: "light3" },
        ),
        // A dash-in strike; its recovery starts from a lunge, so the chain cancels before the clip's end.
        "light3": (
            category: Attack, classes: [Light],
            slots: ["attack.sword_1h.light3", "attack.sword_1h.light3_rec"], root_scale: 0.25,
            windows: [
                Accept([Light, Heavy, Dodge], 0.10, End),
                Cancel([Dodge], 0.56, End), Cancel([Light, Heavy], 0.70, End), Cancel([Move], 1.15, End),
                Turn(360.0, 0.0, 0.15), NoTurn(0.15, 0.52),
            ],
            hits: [(window: (0.38, 0.52), mv: 1.0, stamina: 12.0, kind: "slash", tier: Small, stop: 0.05)],
            next: { Light: "light4" },
        ),
        // The finisher: a lunge (hit at 0.30), a held follow-through (0.42-1.02), then it steps forward
        // into stance inside the same take.
        "light4": (
            category: Attack, classes: [Light],
            slots: ["attack.sword_1h.light4"], root_scale: 0.22,
            windows: [
                Accept([Light, Heavy, Dodge], 0.10, End),
                Cancel([Dodge], 0.50, End), Cancel([Light, Heavy], 1.05, End), Cancel([Move], 1.25, End),
                Turn(360.0, 0.0, 0.15), NoTurn(0.15, 0.38),
            ],
            hits: [(window: (0.23, 0.37), mv: 1.2, stamina: 14.0, kind: "slash", tier: Medium, stop: 0.07)],
            next: { Light: "light1" },
        ),
        "roll": (
            category: Dodge, classes: [Dodge], from: [Any], rank: 10,
            slots: ["dodge.roll.fwd"], rate: 1.25, root_scale: 0.75, square_up: Stick,
            cost: 12.0, iframes: [(0.02, 0.40, All)],
            // Cancels open as the motion ends (Roll: 99% of its travel by clip 0.87 s = move 0.69 s), no settle tail.
            windows: [Cancel([Light, Heavy], 0.70, End), Cancel([Dodge], 0.72, End), Cancel([Move], 0.74, End), NoTurn(0.0, End)],
            // Locked on (C1c), the stick's side of the target picks the roll. Front and back keep
            // this roll squared up to the stick: no back-roll or backstep clip yet, so a back
            // input turns away and rolls clear (the ER back roll's travel, not its look).
            locked: { Left: "roll_left", Right: "roll_right" },
        ),
        // Reached only through `locked`: the body faces the target, the clip carries it sideways.
        // UAL1_RM Dodge_Left/Right: 1.30 s clip, root travel 2.01 m (glb units) done by clip 0.47 s
        // (99%; Roll: 4.99 m by 0.87 s). Rate 1.4 puts the end of motion at move 0.33 s; the cancels
        // open right after it so the clip's settle tail never holds the player.
        "roll_left": (
            category: Dodge, classes: [Dodge],
            slots: ["dodge.roll.left"], rate: 1.4, square_up: Lock,
            cost: 12.0, iframes: [(0.02, 0.30, All)],
            windows: [Cancel([Dodge], 0.34, End), Cancel([Light, Heavy], 0.36, End), Cancel([Move], 0.38, End), NoTurn(0.0, End)],
        ),
        "roll_right": (
            category: Dodge, classes: [Dodge],
            slots: ["dodge.roll.right"], rate: 1.4, square_up: Lock,
            cost: 12.0, iframes: [(0.02, 0.30, All)],
            windows: [Cancel([Dodge], 0.34, End), Cancel([Light, Heavy], 0.36, End), Cancel([Move], 0.38, End), NoTurn(0.0, End)],
        ),
    },
    reactions: {
        (Small, Front): "react.small.front",
        (Small, Left): "react.small.left",
        (Small, Right): "react.small.right",
        (Small, Back): "react.small.back",
        (Medium, Front): "react.medium.front",
        (Large, Front): "react.large.front",
    },
    costs: (jump: 10.0, sprint_per_s: 11.0),
)
