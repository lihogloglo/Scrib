            density: 4.0, // Guess (owner 2026-11-23: too sparse at 1.6), instances per m² at rule weight 1 (saturates at 1 / footprint²)
            slope_deg: Some((min: 0.0, max: 35.0)), // Guess
            water_m: Some((min: 0.2, max: 100000.0)), // Guess, metres above the sea surface
            scale: (min: 0.8, max: 1.2), // Guess
            yaw_deg: (min: 0.0, max: 360.0),
