    // Blade looks the `Blade(style: ..)` species name (slices GC-3e1, GC-3e2a; `mw_world::groundcover::BladeStyleDef`):
    // a `bevy_grass` preset by its lower-case name (`base`) and overrides of its look, each `None` (left out) keeping
    // the preset's. Groups and fields (units in the names, colours sRGB 0-1):
    //   blade: height_m (shortest, tallest), width_m, lean, stiffness, root_color, tip_color, root_occlusion,
    //          translucency, specular, twist, droop, fold, head_length, head_width_m, head_color
    //   variation: patch_color, patch_amount, patch_size_m, dry_tips, dead_share, tufts, tuft_spacing_m, bare_share,
    //              bare_patch_size_m
    //   ground_tint: color, amount;  toon_bands (0 = physical shading)
    //   ground_from: a channel `name` (below): the ground tint colour is the mean albedo of its land textures (from the
    //                bake's layer table); an explicit `ground_tint.color` wins.
    //   species: other plants among the style's blades (slice GC-3e2c), each (base, share, clustering, blade): `base` a
    //            `bevy_grass` species preset by lower-case name (seed_heads, white_flowers, yellow_flowers, clover,
    //            broad_leaf, moss, fern, bracken, leaf_litter, cotton_grass, cattail, cornflower, poppy) or
    //            "style:<preset>" for a style preset's own blade; share 0-1 of the blades; clustering 0 (scattered) to 1
    //            (only in patches, default 0); blade the same overrides as above, on that base. A non-empty list
    //            REPLACES the preset's own species; left out (empty) keeps them. At most 15.
    // The preset's density is never used: the species `density` sets the blades per m². Every override is a `Guess`
    // until the owner's look loop sets it.
    blade_styles: [
        // Ascadian Isles: lush meadow, its tips toned down from the MEADOW preset's saturated green (owner
        // 2026-11-23, GC-M4: "too bright uranium green").
        (
            name: "ascadian",
            base: "meadow", // Guess, lush
            blade: (tip_color: Some((0.34, 0.45, 0.19))), // Guess, desaturated
            variation: (patch_amount: Some(0.2)), // Guess, variety
            ground_tint: (amount: Some(0.35)), // Guess, seated
            ground_from: Some("ascadian_grass"),
        ),
        // Grazelands: open, drier, yellow-green prairie.
        (
            name: "grazelands",
            base: "dry_savanna", // Guess, drier
            blade: (height_m: Some((0.3, 0.7)), tip_color: Some((0.60, 0.58, 0.30))), // Guess, knee-high; Guess, yellow-green
            ground_tint: (amount: Some(0.35)), // Guess, seated
            ground_from: Some("grazelands_grass"),
            // A taller prairie grass in tufts among the short dry blades (owner 2026-11-24: "higher grasses in the
            // grasslands ... a different species"), from the PAMPAS leaf without its plumes.
            species: [
                (
                    base: "style:pampas", // Guess, long arching tuft leaves
                    share: 0.15, // Guess, a minority over the short grass
                    clustering: 0.6, // Guess, in tufts
                    blade: (
                        height_m: Some((1.0, 1.9)), // Guess (owner 2026-11-24: "some could be even higher" at 0.9-1.4), waist to head high
                        width_m: Some(0.012), // Guess, narrower than the base's 0.02
                        droop: Some(0.5), // Guess, arching less than pampas at this height
