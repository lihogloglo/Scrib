# Scrib repository root. Whitelist: only these top-level entries are tracked. Everything else here
# (sdk/ holds NVIDIA's SDK, which may not be redistributed; shots/, procgen/, cloud-prompts/,
# .sessions/, .claude/) stays local. Each component keeps its own .gitignore.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/logo.png
!/LICENSE
!/LICENSE-EXCEPTION.md
# The one Cargo workspace (both components): manifest, lock, toolchain, build config, cargo-deny, cargo-hakari.
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/
!/.config/
!/deny.toml
!/superfargoth/
!/bevyrrowind/
# Repo-wide scripts (doccheck.sh: no-loss check for doc cleanup slices).
!/tools/
